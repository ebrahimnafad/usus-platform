    "lint:console": "node scripts/check-console.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "framer-motion": "^14.9.1",
    "next": "^15.2.0",
